<?xml version="1.0" encoding="utf-8"?>
<!-- Personal-fork: AI carbs estimator, styled like the Dashboard (dark cards) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ai_bg_sheet"
    android:focusableInTouchMode="true"
    tools:context=".dialogs.AiCarbsDialog">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/ai_bg_badge"
                android:importantForAccessibility="no"
                android:padding="7dp"
                android:src="@drawable/ic_ai_sparkle"
                android:tint="@color/ai_purple" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/ai_carbs_title"
                android:textColor="@color/ai_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/history_button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/ai_bg_icon_button"
                android:contentDescription="@string/ai_carbs_history_button"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_recent_history"
                android:tint="@color/ai_sub" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/ai_bg_warning"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="@string/ai_carbs_warning"
            android:textColor="@color/ai_low"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- photo -->
        <LinearLayout style="@style/AiCarbs.Card">

            <TextView
                style="@style/AiCarbs.Label"
                android:text="@string/ai_carbs_image_label" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/image_preview"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:adjustViewBounds="true"
                    android:background="@drawable/ai_bg_field"
                    android:contentDescription="@string/ai_carbs_image_preview_description"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/image_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="88dp"
                    android:background="@drawable/ai_bg_photo"
                    android:gravity="center"
                    android:text="@string/ai_carbs_image_placeholder"
                    android:textColor="@color/ai_dim"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/image_clear_button"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="6dp"
                    android:background="@drawable/ai_bg_icon_button"
                    android:contentDescription="@string/ai_carbs_image_clear"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:tint="@color/ai_text"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/image_camera_button"
                    style="@style/AiCarbs.Button"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_photo_camera"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/ai_text"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/ai_carbs_image_camera"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/image_gallery_button"
                    style="@style/AiCarbs.Button"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_photo_library"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/ai_text"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/ai_carbs_image_gallery"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- food description + estimate -->
        <LinearLayout style="@style/AiCarbs.Card">

            <TextView
                style="@style/AiCarbs.Label"
                android:text="@string/ai_carbs_food_label" />

            <EditText
                android:id="@+id/food_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="no"
                android:background="@drawable/ai_bg_field"
                android:gravity="top|start"
                android:hint="@string/ai_carbs_food_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2"
                android:padding="12dp"
                android:textColor="@color/ai_text"
                android:textColorHint="@color/ai_dim"
                android:textSize="14sp" />

            <Button
                android:id="@+id/estimate_button"
                style="@style/AiCarbs.Button.Purple"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:drawableStart="@drawable/ic_ai_sparkle"
                android:drawableTint="@color/ai_on_purple"
                android:paddingStart="96dp"
                android:paddingEnd="96dp"
                android:text="@string/ai_carbs_estimate_button" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:indeterminateTint="@color/ai_purple"
                android:visibility="gone" />

            <TextView
                android:id="@+id/error_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/ai_low"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/result_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- result: total + confidence + breakdown -->
            <LinearLayout style="@style/AiCarbs.Card">

                <TextView
                    style="@style/AiCarbs.Label"
                    android:layout_marginBottom="0dp"
                    android:text="@string/ai_carbs_result_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/total_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ai_carbs"
                        android:textSize="40sp"
                        android:textStyle="bold"
                        tools:text="78" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/shortgramm"
                        android:textColor="@color/ai_sub"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/confidence_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ai_bg_pill"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="신뢰도: 높음"
                        tools:visibility="visible" />
                </LinearLayout>

                <!-- one row per food item, filled in AiCarbsDialog.bindResult -->
                <LinearLayout
                    android:id="@+id/breakdown_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/assumptions_text"
                    style="@style/AiCarbs.Note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textStyle="italic" />
            </LinearLayout>

            <!-- FPU / duration / strategy (advisory only) -->
            <LinearLayout style="@style/AiCarbs.Card">

                <TextView
                    android:id="@+id/fpu_label"
                    style="@style/AiCarbs.Label"
                    android:layout_marginBottom="4dp"
                    android:text="@string/ai_carbs_fpu_label"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/fpu_text"
                    style="@style/AiCarbs.Note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/duration_text"
                    style="@style/AiCarbs.Note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/ai_text"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/split_advisory_text"
                    style="@style/AiCarbs.Note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/ai_high"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/strategy_label"
                    style="@style/AiCarbs.Label"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/ai_carbs_strategy_label"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/strategy_text"
                    style="@style/AiCarbs.Note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- final value -->
            <LinearLayout style="@style/AiCarbs.Card">

                <TextView
                    style="@style/AiCarbs.Label"
                    android:text="@string/ai_carbs_final_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/minus_button"
                        style="@style/AiCarbs.Button"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="−"
                        android:textSize="20sp" />

                    <EditText
                        android:id="@+id/final_carbs"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:autofillHints="no"
                        android:background="@drawable/ai_bg_field"
                        android:gravity="center"
                        android:inputType="number"
                        android:text="0"
                        android:textColor="@color/ai_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/plus_button"
                        style="@style/AiCarbs.Button"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="+"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/shortgramm"
                        android:textColor="@color/ai_sub"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- actions: cancel / to carbs / to calculator (calculator right, like the Dashboard) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cancel_button"
                style="@style/AiCarbs.Button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@android:string/cancel"
                android:textColor="@color/ai_sub" />

            <Button
                android:id="@+id/apply_carbs_button"
                style="@style/AiCarbs.Button.Carbs"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/ai_carbs_to_carbs" />

            <Button
                android:id="@+id/apply_button"
                style="@style/AiCarbs.Button.Accent"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/ai_carbs_to_wizard" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
