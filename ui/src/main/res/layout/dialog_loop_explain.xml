<?xml version="1.0" encoding="utf-8"?>
<!-- Personal-fork: AI explanation of a loop decision (Dashboard), same dark card style as the AI carbs dialog -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ai_bg_sheet"
    tools:context=".dialogs.LoopExplainDialog">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/ai_bg_badge"
                android:importantForAccessibility="no"
                android:padding="7dp"
                android:src="@drawable/ic_ai_sparkle"
                android:tint="@color/ai_purple" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/loop_explain_title"
                android:textColor="@color/ai_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/run_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ai_sub"
                android:textSize="11sp"
                tools:text="19:02" />
        </LinearLayout>

        <LinearLayout style="@style/AiCarbs.Card">

            <TextView
                style="@style/AiCarbs.Label"
                android:layout_marginBottom="4dp"
                android:text="@string/loop_explain_decision" />

            <TextView
                android:id="@+id/decision"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ai_text"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="임시 기저 0 U/h (30분) · SMB 없음" />

            <TextView
                android:id="@+id/facts"
                style="@style/AiCarbs.Note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                tools:text="IOB 6.90 U · COB 32 g · 예측 최저 78 · 목표 100" />
        </LinearLayout>

        <!-- AI explanation -->
        <LinearLayout
            style="@style/AiCarbs.Card"
            android:background="@drawable/ai_bg_explain">

            <TextView
                style="@style/AiCarbs.Label"
                android:layout_marginBottom="6dp"
                android:text="@string/loop_explain_ai"
                android:textColor="@color/ai_purple" />

            <LinearLayout
                android:id="@+id/loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminateTint="@color/ai_purple" />

                <TextView
                    style="@style/AiCarbs.Note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/loop_explain_loading" />
            </LinearLayout>

            <TextView
                android:id="@+id/explanation"
                style="@style/AiCarbs.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="5dp"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/error_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ai_low"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout style="@style/AiCarbs.Card">

            <TextView
                style="@style/AiCarbs.Label"
                android:layout_marginBottom="4dp"
                android:text="@string/loop_explain_raw" />

            <TextView
                android:id="@+id/raw_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/ai_dim"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            style="@style/AiCarbs.Note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/loop_explain_note"
            android:textSize="11sp" />

        <Button
            android:id="@+id/close_button"
            style="@style/AiCarbs.Button.Purple"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:text="@string/loop_explain_close" />
    </LinearLayout>
</ScrollView>
